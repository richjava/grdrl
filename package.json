{
  "name": "@richjava/grdrl",
  "version": "0.2.0",
  "description": "Detect when required ESLint enforcement has been weakened.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/richjava/grdrl.git"
  },
  "type": "module",
  "bin": {
    "grdrl": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "hooks/protect.mjs",
    "action.yml",
    "README.md",
    "docs/grdrl-logo.jpg"
  ],
  "scripts": {
