    "check": "tsx src/cli.ts check"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "minimatch": "^10.0.3"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@typescript-eslint/parser": "^8.44.0",
    "eslint": "^10.12.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
