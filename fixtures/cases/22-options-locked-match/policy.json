{
  "version": 1,
  "rules": [
    {
      "id": "no-restricted-imports",
      "minSeverity": "error",
      "globs": ["src/**/*.ts"],
      "options": [{ "paths": ["db"] }]
    },
    {
      "id": "no-console",
      "minSeverity": "warn",
      "globs": ["src/**/*.ts"]
    }
  ],
  "lint": {
    "script": "lint",
    "commandIncludes": "eslint"
  },
  "ci": {
    "commandIncludes": ["npm run lint"]
  }
}
