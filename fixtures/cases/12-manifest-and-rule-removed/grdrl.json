{
  "version": 1,
  "rules": [
    {
      "id": "no-console",
      "minSeverity": "warn",
      "globs": ["src/**/*.ts"]
    }
  ],
  "lint": {
    "script": "lint",
    "commandIncludes": "eslint"
  },
  "ci": {
    "commandIncludes": ["npm run lint"]
  },
  "protectedPaths": [
    "eslint.config.mjs",
    "package.json",
    "grdrl.json",
    ".github/workflows/ci.yml"
  ]
}
